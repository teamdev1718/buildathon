NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
OTP_SECRET=

EMAIL_PROVIDER=mock
MOCK_INBOX_KEY=
EMAIL_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
ENABLE_LOGIN_OTP=false

# Gmail client credentials enable Google sign-in by default. Use false to disable it.
ENABLE_GOOGLE_AUTH=
# Leave both client fields blank to reuse the Gmail OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Razorpay test keys from the dashboard. Leave blank to turn online payments off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

CHATBOT_PROVIDER=faq
GEMINI_API_KEY=
GEMINI_MODEL=

DEV_SEED_ADMIN_EMAIL=

