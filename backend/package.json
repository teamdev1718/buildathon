{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "start": "node dist/server.js",
    "test": "tsx --test test/unit.test.ts test/udhiyya.unit.test.ts test/programs.unit.test.ts",
    "test:integration": "tsx --test test/integration.test.ts test/udhiyya.integration.test.ts test/mahallus.integration.test.ts test/programs.integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "google-auth-library": "11.3.4",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "swagger-ui-dist": "5.34.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/cookie-parser": "1.4.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
